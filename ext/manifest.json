{
  "manifest_version": 3,
  "name": "Valkyrja Night for claude.ai (unofficial)",
  "version": "0.4.0",
  "description": "Unofficial true-black restyle for claude.ai. Not affiliated with or endorsed by Anthropic. CSS only, collects no data.",
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "css": [
        "claude.css"
      ],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "valkyrja-night-claude@hrafnavalkyrja.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*.ttf"
      ],
      "matches": [
        "https://claude.ai/*"
      ]
    }
  ],
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  }
}
